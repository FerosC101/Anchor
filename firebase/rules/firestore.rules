rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Users ──────────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if request.auth != null &&
        (request.auth.uid == userId || _isAdmin());
      allow create, update: if request.auth != null &&
        (request.auth.uid == userId || _isAdmin());
      allow delete: if _isAdmin();

      // ── Wage logs (sub-collection) ────────────────────────────────────────
      match /wage_logs/{logId} {
        allow read, create: if request.auth != null &&
          request.auth.uid == userId;
        allow update, delete: if request.auth != null &&
          request.auth.uid == userId;
      }

      // ── Financial Shield profile ──────────────────────────────────────────
      match /financial_shield/{docId} {
        allow read, create, update, delete: if request.auth != null &&
          request.auth.uid == userId;
      }

      // ── Savings goals ─────────────────────────────────────────────────────
      match /savings_goals/{goalId} {
        allow read, create, update, delete: if request.auth != null &&
          request.auth.uid == userId;
      }

      // ── Smart exit plans ──────────────────────────────────────────────────
      match /smart_exit_plans/{planId} {
        allow read, create, update, delete: if request.auth != null &&
          request.auth.uid == userId;
      }
    }

    // ── OFW profiles ──────────────────────────────────────────────────────────
    match /ofw_profiles/{profileId} {
      allow read: if request.auth != null &&
        (resource.data.user_id == request.auth.uid || _isGovernmentOrNgo() || _isAdmin());
      allow create: if request.auth != null;
      allow update: if request.auth != null && resource.data.user_id == request.auth.uid;
      allow delete: if false;
    }

    // ── Organization profiles (Government / NGO) ──────────────────────────────────
    match /organization_profiles/{profileId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null && resource.data.user_id == request.auth.uid;
      allow delete: if false;
    }

    // ── Verifier profiles (NGO / Government verifiers) ───────────────────────
    match /verifier_profiles/{profileId} {
      allow read: if request.auth != null &&
        (resource.data.user_id == request.auth.uid || _isAdmin());
      allow create: if request.auth != null;
      allow update: if request.auth != null && resource.data.user_id == request.auth.uid;
      allow delete: if false;
    }

    // ── Community posts ───────────────────────────────────────────────────────
    match /community_posts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
        request.resource.data.user_id == request.auth.uid;
      allow update, delete: if request.auth != null &&
        resource.data.user_id == request.auth.uid &&
        request.resource.data.user_id == resource.data.user_id;
    }

    // ── Post comments ─────────────────────────────────────────────────────────
    match /post_comments/{commentId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
        request.resource.data.user_id == request.auth.uid;
      allow update, delete: if request.auth != null &&
        resource.data.user_id == request.auth.uid &&
        request.resource.data.user_id == resource.data.user_id;
    }

    // ── Contracts ─────────────────────────────────────────────────────────────
    match /contracts/{contractId} {
      allow read: if request.auth != null &&
        (resource.data.user_id == request.auth.uid || _isGovernmentOrNgo() || _isAdmin());
      allow create: if request.auth != null &&
        request.resource.data.user_id == request.auth.uid;
      allow update: if request.auth != null &&
        resource.data.user_id == request.auth.uid &&
        request.resource.data.user_id == resource.data.user_id;
      allow delete: if false;
    }

    // ── Contract analysis ─────────────────────────────────────────────────────
    match /contract_analysis/{analysisId} {
      allow read: if request.auth != null &&
        (resource.data.user_id == request.auth.uid || _isGovernmentOrNgo() || _isAdmin());
      // Analysis records are written by backend admin SDK only.
      allow create, update: if false;
      allow delete: if false;
    }

    // ── Contract reviews ──────────────────────────────────────────────────────
    match /contract_reviews/{reviewId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && (_isGovernmentOrNgo() || _isAdmin());
      allow delete: if false;
    }

    // ── Job offers ────────────────────────────────────────────────────────────
    match /job_offers/{jobId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && (_isGovernmentOrNgo() || _isAdmin());
      allow delete: if false;
    }

    // ── Notifications ─────────────────────────────────────────────────────────
    match /notifications/{notifId} {
      allow read: if request.auth != null &&
        resource.data.user_id == request.auth.uid;
      allow create: if request.auth != null &&
        (_isAdmin() || request.resource.data.user_id == request.auth.uid);
      allow update: if request.auth != null &&
        resource.data.user_id == request.auth.uid &&
        request.resource.data.user_id == resource.data.user_id;
      allow delete: if false;
    }

    // ── Reports ───────────────────────────────────────────────────────────────
    match /reports/{reportId} {
      allow read: if request.auth != null &&
        (resource.data.reporter_id == request.auth.uid || _isAdmin());
      allow create: if request.auth != null &&
        request.resource.data.reporter_id == request.auth.uid;
      allow update, delete: if false;
    }

    // ── Remittance rates (read-only for OFWs) ───────────────────────────────
    match /remittance_rates/{rateId} {
      allow read: if request.auth != null;
      allow create, update, delete: if _isAdmin();
    }

    // ── Remittance providers (read-only for OFWs) ──────────────────────────
    match /remittance_providers/{providerId} {
      allow read: if request.auth != null;
      allow create, update, delete: if _isAdmin();
    }

    // ── AI usage logs (server-side only) ─────────────────────────────────────
    match /ai_usage_logs/{logId} {
      allow read, write: if false;
    }

    // ── Helper functions ──────────────────────────────────────────────────────
    function _role() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function _isGovernmentOrNgo() {
      return request.auth != null && (_role() == 'government' || _role() == 'ngo');
    }
    function _isAdmin() {
      return request.auth != null && _role() == 'admin';
    }
  }
}
